    "serverpath": "C:/msys64/mingw64/bin/openocd.exe",
    "configFiles": [
        "interface/stlink.cfg",
        "target/stm32h7x.cfg"
    ],
    "searchDir": [
        "C:/msys64/mingw64/share/openocd/scripts"
    ],
    // ЭТО РЕШИТ ПРОБЛЕМУ ПОДКЛЮЧЕНИЯ:
   "serverArgs": [
